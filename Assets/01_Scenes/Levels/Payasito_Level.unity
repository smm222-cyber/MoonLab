    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[0].choices.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[1].choices.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[3].choices.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[5].choices.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[5].choices.Array.data[0].choiceText
      value: Pregunta sobre el
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[5].choices.Array.data[1].choiceText
      value: Pregunta sobre ti
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[5].choices.Array.data[0].responseDialogue
      value: "\xBFSobre m\xED? Bueno\u2026 yo era el que hac\xEDa re\xEDr a todos.
        Mi trabajo era simple, esconder mis l\xE1grimas detr\xE1s de colores brillantes.\nCada
        globo, cada gesto, cada ca\xEDda\u2026 era para escuchar una carcajada m\xE1s.
        Pero en mi \xFAltimo acto, algo sali\xF3 mal. Un estallido de tinta, y el
        p\xFAblico termin\xF3 cubierto de manchas, rieron, s\xED\u2026 pero no conmigo.
        De m\xED.\nDesde entonces, no se si merezco estar aqu\xED. A veces pienso
        que los globos saben m\xE1s de m\xED que yo mismo\u2026\nporque ellos s\xED
        saben cu\xE1ndo volver a levantarse."
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: missions.Array.data[5].choices.Array.data[1].responseDialogue
      value: "Sobre ti... No ven\xEDas caminando\u2026 Las luces se apagaron, el
        viento cambi\xF3, y de pronto estabas ah\xED, mirando la pista con esos ojos
        que parec\xEDan recordar algo que nosotros hab\xEDamos olvidado. La carpa
        parece reir y llorar, nadie habla pero todos lo sienten. T\xFA dices que
        no sabes qui\xE9n eres\u2026 pero creo que el circo s\xED lo sabe. Y eso,
        peque\xF1a\u2026 da m\xE1s miedo que cualquier funci\xF3n que hayamos hecho."
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452850, guid: be4b23bc0fccb1c47803db7d6ea7a6a8, type: 3}
      propertyPath: m_RootOrder
      value: 11
      objectReference: {fileID: 0}
