  m_GameObject: {fileID: 1106715511}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f2522e4f55b1cf4cb5c4c6123409f05, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  groupName: "Conversaci\xF3n"
  groupIcon: {fileID: 0}
  interactUI: {fileID: 0}
  initialConversation:
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: 550d582a1790b7d449079a34f4abcb19, type: 3}
    dialogue: ....
  - speakerName: Maestro de ceremonias
    speakerSprite: {fileID: 21300000, guid: a44941ec9d746f645be8ae1e3224fead, type: 3}
    speakerSound: {fileID: 8300000, guid: c39d011117903cf4f8855467eb850328, type: 3}
    dialogue: "Ya van m\xE1s de una semana peleadas, deben arreglarlo ya."
  - speakerName: Maestro de ceremonias
    speakerSprite: {fileID: 21300000, guid: 8e6ddc9d85fbb1e40a3d30008d72f39f, type: 3}
    speakerSound: {fileID: 8300000, guid: c39d011117903cf4f8855467eb850328, type: 3}
    dialogue: Lo siento, pero estan afectando el ambiente del circo.
  - speakerName: ...
    speakerSprite: {fileID: 21300000, guid: fd64d4777b3b6ad4ea0ef4b251ac66ae, type: 3}
    speakerSound: {fileID: 8300000, guid: d84309797f8f75847864047828f6daf6, type: 3}
    dialogue: Me pregunto que pasa, todos parecen tensos.
  missionRequired: Preguntar por la pelea
  afterMissionConversation:
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: 550d582a1790b7d449079a34f4abcb19, type: 3}
    dialogue: "Hace c\xFAanto estas aca, no te hab\xEDa notado."
  - speakerName: ...
    speakerSprite: {fileID: 21300000, guid: fd64d4777b3b6ad4ea0ef4b251ac66ae, type: 3}
    speakerSound: {fileID: 8300000, guid: d84309797f8f75847864047828f6daf6, type: 3}
    dialogue: "No era mi intenci\xF3n escuchar, pero quer\xEDa ver si necesitabas
      ayuda."
  - speakerName: Maestro de ceremonias
    speakerSprite: {fileID: 21300000, guid: a44941ec9d746f645be8ae1e3224fead, type: 3}
    speakerSound: {fileID: 8300000, guid: c39d011117903cf4f8855467eb850328, type: 3}
    dialogue: "Nuestras pintacaritas tuvieron una discusi\xF3n. "
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: a0db7adbbfb018447bea4d4b851fb636, type: 3}
    dialogue: "Ella pint\xF3 un rostro sin m\xED. Una ni\xF1a con estrellas en las
      mejillas\u2026\ny olvid\xF3 el sol en sus ojos.\nDijo que el brillo ya no hac\xEDa
      falta, senti que yo no hacia falta"
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: a0db7adbbfb018447bea4d4b851fb636, type: 3}
    dialogue: "Ella dice que lo \xF3lvide, pero siempre crei que pintariamos juntas,
      me dolio algo tan peque\xF1o"
  - speakerName: ...
    speakerSprite: {fileID: 21300000, guid: 17a55fcdb58a0754cacc7ca3e5359f9f, type: 3}
    speakerSound: {fileID: 8300000, guid: a0db7adbbfb018447bea4d4b851fb636, type: 3}
    dialogue: Ire con ella, seguro que no quiso dar a entender eso.
  missionRequiredForFinalConversation: Hablar con la pintacaritas
  finalConversation:
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: 550d582a1790b7d449079a34f4abcb19, type: 3}
    dialogue: "\xBFTe das cuenta...? Cuando mezclamos, el color vuelve a ser infinito
      para ambas. Gracias por traerme la carta si nos podr\xEDas ayudar con algo
      m\xE1s. Dile que vaya alistando las pinturas para poder continuar con nuestro
      trabajo"
  - speakerName: ...
    speakerSprite: {fileID: 21300000, guid: 17a55fcdb58a0754cacc7ca3e5359f9f, type: 3}
    speakerSound: {fileID: 8300000, guid: d84309797f8f75847864047828f6daf6, type: 3}
    dialogue: "Su amistad debe ser muy fuerte... Ir\xE9 a decirle eso."
  - speakerName: Pinta Carita
    speakerSprite: {fileID: 21300000, guid: cae34f637eea25e42842c3db9ce0aef0, type: 3}
    speakerSound: {fileID: 8300000, guid: d84309797f8f75847864047828f6daf6, type: 3}
    dialogue: "El circo\u2026 est\xE1 brillando otra vez."
  missionToGiveAfterInitial: "Averiguar qu\xE9 est\xE1 pasando"
  missionToCompleteWhenShowingAfter: Preguntar por la pelea
  missionToGiveAfterSecond: Escuchar la historia completa
  missionToCompleteInFinalConversation: Hablar con la pintacaritas
  missionToGiveAfterFinal: Informar encuentro
  typingSound: {fileID: 0}
  isActive: 1
