      value: 45
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: b78914cf4ec47f14fa9b6cdb09d3ce3d, type: 3}
      propertyPath: missions.Array.data[0].dialogueText
      value: "\xBFT\xFA tamb\xEDen tienes curiosidad sobre qu\xE9 esta pasando con
        las pintacaritas? Por lo que escuch\xE9 pelearon. La verdad ser\xEDa una
        pena que su amistad acabe, cuando yo llegu\xE9 ellas ya estaban en el circo,
        siempre las ve\xEDas juntas por todos lados. Tal vez podr\xEDas ayudarlas
        como me ayudaste a mi. Tienes un don para reconectar las cosas."
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: b78914cf4ec47f14fa9b6cdb09d3ce3d, type: 3}
      propertyPath: missions.Array.data[1].dialogueText
      value: "Asi que eso fue lo que sucedi\xF3..."
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: b78914cf4ec47f14fa9b6cdb09d3ce3d, type: 3}
      propertyPath: missions.Array.data[0].missionToGive
      value: Preguntar por la pelea
      objectReference: {fileID: 0}
    - target: {fileID: 3368337943354452849, guid: b78914cf4ec47f14fa9b6cdb09d3ce3d, type: 3}
      propertyPath: missions.Array.data[1].missionToGive
